{
  "schemaVersion": 1,
  "id": "pipeline",
  "title": "Pipeline · Sales & Deals",
  "caption": "Every deal, every stall · one screen",
  "railTitle": "PIPELINE",
  "provider": "postgres",
  "department": ["sales", "deals"],
  "order": 2,
  "buildPrompt": "the revenue command center for the sales and deals branches: stage-by-stage pipeline value, stalled deals with their age, and where the pipeline came from — every number written to Postgres by the deal-sync agent, none of it typed by a human",
  "filters": { "type": "segmented", "options": ["All", "Stalled", "Closing ≤30d"], "default": "All" },
  "kpis": [
    {
      "label": "Pipeline value",
      "icon": "wallet",
      "format": "currency",
      "query": { "source": "sql", "name": "pipeline_value", "params": { "days": 30 } },
      "caption": "open deals, all stages"
    },
    {
      "label": "Open deals",
      "icon": "layers",
      "format": "number",
      "query": { "source": "sql", "name": "deals_open_count" },
      "caption": "not won, not lost"
    },
    {
      "label": "Stalled value",
      "icon": "alert",
      "format": "currency",
      "query": { "source": "sql", "name": "pipeline_stalled_value", "params": { "stale_days": 21 } },
      "caption": "untouched beyond the stale window"
    },
    {
      "label": "Win rate",
      "icon": "target",
      "format": "percent",
      "query": { "source": "sql", "name": "deal_win_rate", "params": { "days": 90 } },
      "caption": "closed-won over closed, 90d"
    },
    {
      "label": "Median deal age",
      "icon": "timer",
      "format": "duration",
      "query": { "source": "sql", "name": "deal_age_p50" },
      "caption": "first touch to today"
    },
    {
      "label": "Sales agent runs",
      "icon": "activity",
      "format": "number",
      "query": { "source": "langfuse", "metric": "runs", "filter": { "department": "sales" }, "range": "28d" },
      "caption": "the sales branch, last 28d"
    }
  ],
  "signals": [
    {
      "tone": "warn",
      "lead": "{value} is sitting still in the pipeline",
      "detail": "Reactivation drafts are what the outreach-writing cluster is for — the drafts wait for your approval, not the other way round.",
      "query": { "source": "sql", "name": "pipeline_stalled_value", "params": { "stale_days": 21 } },
      "format": "currency",
      "hideWhenZero": true,
      "pending": "Stall detection lights up when the deal-sync agent writes its first rows to Postgres."
    },
    {
      "tone": "wait",
      "lead": "No deal rows in Postgres yet",
      "detail": "This center is wired end to end and deliberately empty: the deal-sync agent has not run. Nothing here is a placeholder number."
    }
  ],
  "widgets": [
    {
      "id": "by-stage",
      "type": "bar-list",
      "title": "Pipeline by stage",
      "tone": "coral",
      "format": "currency",
      "span": 1,
      "query": { "source": "sql", "name": "pipeline_by_stage", "shape": "list" },
      "emptyState": "No stages yet — the deal-sync agent writes this table on its first run."
    },
    {
      "id": "by-source",
      "type": "source-bar-list",
      "title": "Pipeline by source",
      "tone": "grey",
      "format": "currency",
      "span": 1,
      "query": { "source": "sql", "name": "pipeline_by_source", "shape": "list" },
      "emptyState": "No sources yet — lead-sourcing agents attribute deals as they create them."
    },
    {
      "id": "deals",
      "type": "data-table",
      "title": "Deals",
      "subtitle": "Click a row to peek inside",
      "sortable": true,
      "rowAction": "peek",
      "span": 2,
      "columns": [
        { "key": "deal", "label": "Deal", "type": "text" },
        { "key": "stage", "label": "Stage", "type": "chip" },
        { "key": "value", "label": "Value", "type": "number", "format": "currency", "align": "right" },
        { "key": "owner", "label": "Owner", "type": "text" },
        { "key": "age", "label": "Untouched", "type": "number", "format": "duration", "align": "right" }
      ],
      "query": { "source": "sql", "name": "deals_open_list", "shape": "list", "limit": 25 },
      "emptyState": "No deals yet — the deal-sync agent writes this table on its first run."
    },
    {
      "id": "created",
      "type": "area-chart",
      "title": "Pipeline created",
      "tone": "lavender",
      "format": "currency",
      "span": 1,
      "query": { "source": "sql", "name": "pipeline_created_series", "shape": "series", "range": "28d" },
      "emptyState": "Nothing created in the last 28d — new deals land here as agents source them."
    },
    {
      "id": "sales-activity",
      "type": "activity-feed",
      "title": "The sales branch, run by agents",
      "span": 1,
      "limit": 8,
      "query": {
        "source": "langfuse",
        "metric": "runs",
        "shape": "list",
        "filter": { "department": "sales" },
        "limit": 8
      },
      "emptyState": "No sales-branch runs yet — this feed is live the moment one runs."
    }
  ]
}
