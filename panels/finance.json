{
  "schemaVersion": 1,
  "id": "finance",
  "title": "Finance · Spend & Runway",
  "caption": "What the agents cost, what the stack costs, what is left",
  "railTitle": "FINANCE",
  "provider": "langfuse",
  "department": ["back-office"],
  "order": 6,
  "buildPrompt": "the finance command center for the back-office branch: model spend per agent straight from Langfuse — the one finance number that is real on day one — alongside infra cost and the invoice ledger the back-office agents write",
  "filters": { "type": "range", "options": ["7d", "14d", "28d"], "default": "28d" },
  "kpis": [
    {
      "label": "Model spend",
      "icon": "wallet",
      "format": "currency",
      "query": { "source": "langfuse", "metric": "cost", "range": "$range" },
      "delta": {
        "query": { "source": "langfuse", "metric": "cost", "range": "$range", "compare": "previous-period" },
        "goodDirection": "down"
      },
      "caption": "the runner's API workspace",
      "sparkline": {
        "query": { "source": "langfuse", "metric": "cost", "shape": "series", "groupBy": "day", "range": "$range" },
        "tone": "coral"
      }
    },
    {
      "label": "Runs billed",
      "icon": "activity",
      "format": "number",
      "query": { "source": "langfuse", "metric": "runs", "range": "$range" },
      "delta": {
        "query": { "source": "langfuse", "metric": "runs", "range": "$range", "compare": "previous-period" },
        "goodDirection": "up"
      },
      "caption": "every run has a cost line"
    },
    {
      "label": "Infra cost",
      "icon": "database",
      "format": "currency",
      "query": { "source": "sql", "name": "infra_cost_total", "range": "$range" },
      "caption": "the compose stack, this window"
    },
    {
      "label": "Revenue booked",
      "icon": "chart",
      "format": "currency",
      "query": { "source": "sql", "name": "revenue_booked", "range": "$range" },
      "caption": "invoices raised in this window"
    },
    {
      "label": "Outstanding",
      "icon": "alert",
      "format": "currency",
      "query": { "source": "sql", "name": "invoices_outstanding" },
      "caption": "raised and unpaid"
    },
    {
      "label": "Runway",
      "icon": "timer",
      "format": "duration",
      "query": { "source": "sql", "name": "runway_estimate" },
      "caption": "at the current burn"
    }
  ],
  "signals": [
    {
      "tone": "ok",
      "lead": "{value} of model spend in this window",
      "detail": "The runner holds a separate API-key workspace with a hard monthly cap, so this number cannot surprise you (Part V).",
      "query": { "source": "langfuse", "metric": "cost", "range": "$range" },
      "format": "currency",
      "pending": "No model spend recorded yet — Langfuse gets its first cost line on the first run."
    },
    {
      "tone": "wait",
      "lead": "Invoices and infra cost are not in Postgres yet",
      "detail": "Model spend above is real; everything sourced from the back-office agents waits for those agents to run."
    }
  ],
  "widgets": [
    {
      "id": "spend-by-agent",
      "type": "cost-table",
      "title": "Model spend by agent",
      "format": "currency",
      "showTotal": true,
      "totalLabel": "Window total",
      "span": 1,
      "query": { "source": "langfuse", "metric": "cost", "shape": "list", "groupBy": "agent", "range": "$range" },
      "emptyState": "No spend in this window."
    },
    {
      "id": "daily-spend",
      "type": "area-chart",
      "title": "Spend per day",
      "tone": "coral",
      "format": "currency",
      "span": 1,
      "query": { "source": "langfuse", "metric": "cost", "shape": "series", "groupBy": "day", "range": "$range" },
      "emptyState": "No spend in this window."
    },
    {
      "id": "infra",
      "type": "source-bar-list",
      "title": "Infra cost by service",
      "subtitle": "web · runner · langfuse · postgres · caddy",
      "tone": "grey",
      "format": "currency",
      "span": 1,
      "query": { "source": "sql", "name": "infra_cost_by_service", "shape": "list", "range": "$range" },
      "emptyState": "No infra rows yet — the cost-tracker agent writes this table on its first run."
    },
    {
      "id": "spend-by-model",
      "type": "bar-list",
      "title": "Spend by model",
      "tone": "coral",
      "format": "currency",
      "span": 1,
      "query": { "source": "langfuse", "metric": "cost", "shape": "list", "groupBy": "model", "range": "$range" },
      "emptyState": "No spend in this window."
    },
    {
      "id": "invoices",
      "type": "data-table",
      "title": "Invoice ledger",
      "subtitle": "Click a row to peek inside",
      "sortable": true,
      "rowAction": "peek",
      "span": 2,
      "columns": [
        { "key": "invoice", "label": "Invoice", "type": "text" },
        { "key": "client", "label": "Client", "type": "text" },
        { "key": "state", "label": "State", "type": "chip" },
        { "key": "amount", "label": "Amount", "type": "number", "format": "currency", "align": "right" },
        { "key": "age", "label": "Outstanding", "type": "number", "format": "duration", "align": "right" }
      ],
      "query": { "source": "sql", "name": "invoice_ledger", "shape": "list", "limit": 25 },
      "emptyState": "No invoices yet — the back-office billing agent writes this ledger on its first run."
    }
  ]
}
