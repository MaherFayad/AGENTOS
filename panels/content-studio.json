{
  "schemaVersion": 1,
  "id": "content-studio",
  "title": "Content · Studio & Distribution",
  "caption": "What got made, what got published, what landed",
  "railTitle": "CONTENT",
  "provider": "postgres",
  "department": ["marketing"],
  "order": 4,
  "buildPrompt": "the content command center for the marketing branch: daily views as an area chart, where the views came from, the publishing queue with its review states, and the feed of what the content agents drafted and shipped",
  "filters": { "type": "range", "options": ["7d", "14d", "28d"], "default": "14d" },
  "kpis": [
    {
      "label": "Published",
      "icon": "file",
      "format": "number",
      "query": { "source": "sql", "name": "content_published_count", "range": "$range" },
      "caption": "pieces live in this window"
    },
    {
      "label": "Views",
      "icon": "eye",
      "format": "number",
      "query": { "source": "sql", "name": "content_views_total", "range": "$range" },
      "caption": "across every channel"
    },
    {
      "label": "Engagement rate",
      "icon": "target",
      "format": "percent",
      "query": { "source": "sql", "name": "content_engagement_rate", "range": "$range" },
      "caption": "interactions over views"
    },
    {
      "label": "In review",
      "icon": "clock",
      "format": "number",
      "query": { "source": "sql", "name": "content_drafts_in_review" },
      "caption": "drafts waiting on a human"
    },
    {
      "label": "Draft to publish",
      "icon": "timer",
      "format": "duration",
      "query": { "source": "sql", "name": "content_time_to_publish_p50" },
      "caption": "median, first draft to live"
    },
    {
      "label": "Content agent runs",
      "icon": "activity",
      "format": "number",
      "query": { "source": "langfuse", "metric": "runs", "filter": { "department": "marketing" }, "range": "$range" },
      "caption": "the marketing branch, this window"
    }
  ],
  "signals": [
    {
      "tone": "wait",
      "lead": "{value} drafts are waiting on a human",
      "detail": "Nothing publishes itself here — approval is the point, and the drafts sit until you clear them.",
      "query": { "source": "sql", "name": "content_drafts_in_review" },
      "format": "number",
      "hideWhenZero": true,
      "pending": "The review queue appears once the content agents write their first drafts."
    },
    {
      "tone": "wait",
      "lead": "Channel metrics are not connected yet",
      "detail": "Views and engagement land in Postgres via the distribution agent; until it runs, every chart on this center stays empty on purpose."
    }
  ],
  "widgets": [
    {
      "id": "daily-views",
      "type": "area-chart",
      "title": "Daily views",
      "subtitle": "Hover a spike for what caused it",
      "tone": "coral",
      "format": "number",
      "span": 2,
      "query": { "source": "sql", "name": "content_views_series", "shape": "series", "range": "$range" },
      "emptyState": "No views in this window — the distribution agent writes this series after each publish."
    },
    {
      "id": "views-by-channel",
      "type": "source-bar-list",
      "title": "Views by channel",
      "tone": "grey",
      "format": "number",
      "span": 1,
      "query": { "source": "sql", "name": "content_views_by_channel", "shape": "list", "range": "$range" },
      "emptyState": "No channels yet — each publish target appears here after its first post."
    },
    {
      "id": "top-pieces",
      "type": "bar-list",
      "title": "Top pieces by views",
      "tone": "coral",
      "format": "number",
      "span": 1,
      "query": { "source": "sql", "name": "content_top_pieces", "shape": "list", "range": "$range", "limit": 8 },
      "emptyState": "Nothing published in this window."
    },
    {
      "id": "queue",
      "type": "data-table",
      "title": "Publishing queue",
      "subtitle": "Click a row to peek inside",
      "sortable": true,
      "rowAction": "peek",
      "span": 1,
      "columns": [
        { "key": "piece", "label": "Piece", "type": "text" },
        { "key": "channel", "label": "Channel", "type": "text" },
        { "key": "state", "label": "State", "type": "chip" },
        { "key": "scheduled", "label": "Goes out in", "type": "number", "format": "duration", "align": "right" }
      ],
      "query": { "source": "sql", "name": "content_queue", "shape": "list", "limit": 25 },
      "emptyState": "Nothing queued — the content agents write drafts here before they publish."
    },
    {
      "id": "content-activity",
      "type": "activity-feed",
      "title": "Today, run by agents",
      "span": 1,
      "limit": 8,
      "query": {
        "source": "langfuse",
        "metric": "runs",
        "shape": "list",
        "filter": { "department": "marketing" },
        "limit": 8
      },
      "emptyState": "No marketing-branch runs yet — this feed is live the moment one runs."
    }
  ]
}
