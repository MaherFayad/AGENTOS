node_modules/
.next/
# `next build` output — separate from the dev server's .next on purpose (apps/web/next.config.mjs)
.next-build/
# `scripts/smoke-routes.mjs` boots its own dev server (ADR-035) and must not write the
# developer's `.next` out from under a running one.
.next-smoke/
# `scripts/check-page-errors.mjs` boots a third one, for the same reason.
.next-pagecheck/
# `scripts/check-sw-poisoning.mjs` boots a fourth: it needs a browser profile that keeps a
# service worker across loads, which the other gates deliberately never have.
.next-swprobe/
dist/
build/
out/
coverage/
*.tsbuildinfo

.env
.env.*
!.env.example

# runner scratch workspaces (per-run cwd, §3.2)
.runs/
.runner/
apps/runner/.workspaces/

# generated layout (ADR-003 — build artifact, never committed)
apps/web/public/graph.json

# Next writes this file on every dev/build and, since `next build` got its own distDir,
# its `/// <reference path>` line points at `.next/types` or `.next-build/types` depending
# on which command ran last. Tracked, that is a permanent dirty line in everyone's
# worktree and eventually a noise commit. tsconfig.json includes BOTH types dirs, and
# `tsc --noEmit` passes with this file absent entirely (verified), so nothing needs it.
apps/web/next-env.d.ts

# Second Brain completeness cache (computed, never a source of truth)
company/.brain.json

# local volumes
.volumes/

.DS_Store
Thumbs.db
*.log
.gstack/
